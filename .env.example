# Copy this file to .env and fill it in. Never commit .env.

# --- Vonage Video (required) -------------------------------------------------------
# Application ID (a UUID) of a Vonage application with Video capabilities enabled.
VONAGE_APPLICATION_ID=
# Path, on this machine, to the private key Vonage generated for that application.
# docker compose mounts it read-only into the container; it never enters the image.
VONAGE_PRIVATE_KEY_FILE=./secrets/private.key

# --- Speech-to-text: Deepgram (required unless AGENT_MODE=echo) ---------------------
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3-general
# A language code Deepgram supports for that model, for example en, en-GB, or es.
DEEPGRAM_LANGUAGE=en
# Optional, comma-separated: words Deepgram should listen for, such as product or
# people's names it would otherwise mishear. Keyterm prompting works with Nova-3
# models and Deepgram bills it as a small per-minute add-on, so it's off by default.
DEEPGRAM_KEYTERMS=

# --- LLM: OpenAI (required unless AGENT_MODE=echo) ----------------------------------
# API billing is separate from a ChatGPT subscription.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Models the waiting room offers (comma-separated). OPENAI_MODEL is always included.
OPENAI_MODELS=gpt-4.1,gpt-4.1-mini

# --- Text-to-speech: ElevenLabs (required unless AGENT_MODE=echo) -------------------
# Voice Library voices, including the default below, need a paid ElevenLabs plan
# when used through the API.
ELEVENLABS_API_KEY=
# Default: "Eddie - Natural and Helpful". Copy any voice ID from the ElevenLabs
# Voice Library or My Voices to change it.
ELEVENLABS_VOICE_ID=l7kNoIfnJKPg7779LI2t
ELEVENLABS_MODEL=eleven_flash_v2_5
# Recommended voices in the waiting room, as VOICE_ID:Name separated by semicolons.
# Leave empty for five of ElevenLabs' recommended voices. If your API key also has the
# Voices: Read permission, the voices in your ElevenLabs account are listed too.
ELEVENLABS_VOICES=

# --- Agent ---------------------------------------------------------------------------
# modular: Deepgram -> OpenAI -> ElevenLabs.
# echo:    diagnostic. The agent beeps, then echoes your microphone back through
#          Vonage Video. No AI provider keys or cost; proves audio flows both ways.
AGENT_MODE=modular

# --- Limits (they protect your bill) -----------------------------------------------
MAX_ACTIVE_SESSIONS=1
MAX_SESSION_SECONDS=600
IDLE_TIMEOUT_SECONDS=120
READY_TIMEOUT_SECONDS=60
SESSION_CREATES_PER_MINUTE=6

# --- Logging -------------------------------------------------------------------------
# DEBUG also turns on the native Video Connector's own (unredacted) INFO logs.
LOG_LEVEL=INFO
# true: also log what you and the agent say. The page always shows it; nothing is stored.
LOG_TRANSCRIPTS=false

# --- Local port ----------------------------------------------------------------------
# The app is served at http://localhost:PORT
PORT=8000
